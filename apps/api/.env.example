NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://control:local-development-only@localhost:55432/control
TEST_DATABASE_URL=postgres://control:local-development-only@localhost:55432/control_test
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH=generate-with-pnpm-password-hash
PROVIDER_MODE=mock
WORKER_ENABLED=true
RESOURCE_ID=3b705c6a-d850-4e52-bdc3-1cbb10954f62
RESOURCE_NAME=Signal demo
# Required only in railway mode. No credentials are needed for mock mode.
# RAILWAY_TOKEN=
# These identify the managed workload, not Railway's injected hosting IDs.
# RAILWAY_TARGET_PROJECT_ID=
# RAILWAY_TARGET_ENVIRONMENT_ID=
# RAILWAY_TARGET_SERVICE_ID=
# Exact Railway source image; a digest-pinned reference is also supported.
# RAILWAY_IMAGE=nginx
# PROXY_TRUST_HOPS=1
